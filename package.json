{
  "name": "thothia",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/api/server.ts",
    "build": "tsc",
    "start": "node src/api/server.js",
    "prisma:generate": "npx prisma generate --schema=./data/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=./data/prisma/schema.prisma --name init",
    "prisma:seed": "ts-node ./data/prisma/seed.ts",
    "prisma:studio": "npx prisma studio --schema=./data/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
